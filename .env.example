# Copy this file to .env and fill in the values from LINE Developers Console.
# Never commit .env or paste its secret values into issues or pull requests.

# Messaging API > Channel access token
LINE_CHANNEL_ACCESS_TOKEN=

# Basic settings > Channel secret
LINE_CHANNEL_SECRET=

# Password for the local administrator screen (/front).
ADMIN_PASSWORD=e2e-admin

# Resolved relative to .code when using the documented start command.
HRS_DB_PATH=hrs_e2e_line.db
